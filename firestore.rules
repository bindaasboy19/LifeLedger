rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCoordinator() {
      return hasRole('admin') || hasRole('hospital') || hasRole('blood_bank');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Stock Collection
    match /blood_stock/{stockId} {
      allow read: if isAuthenticated();
      allow write: if isCoordinator();
    }

    // Stock Flow Logs
    match /stock_flow/{flowId} {
      allow read: if isCoordinator();
      allow write: if isCoordinator();
    }

    // SOS Requests Collection
    match /sos_requests/{sosId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.requesterUid == request.auth.uid ||
        resource.data.acceptedDonorUid == request.auth.uid ||
        isCoordinator()
      );
      allow delete: if isAdmin();
    }

    // SOS Dispatch Offers
    match /sos_dispatch_offers/{offerId} {
      allow read: if isAuthenticated() && (
        resource.data.donorUid == request.auth.uid ||
        resource.data.requesterUid == request.auth.uid ||
        isCoordinator()
      );
      allow write: if isAuthenticated();
    }

    // SOS Tracking
    match /sos_tracking/{trackingId} {
      allow read: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isCoordinator()
      );
      allow write: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        isCoordinator()
      );
    }

    // Donation Camps
    match /donation_camps/{campId} {
      allow read: if isAuthenticated();
      allow create, update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // Camp Applications
    match /camp_applications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isCoordinator()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isCoordinator()
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create, delete: if isCoordinator();
    }

    // Email Jobs (System Only)
    match /email_jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
